{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DigitalSoul",
  "version": "0.1.0",
  "identifier": "in.digitalsoul.notch",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "notch", "title": "DigitalSoul", "width": 420, "height": 64,
      "resizable": false, "decorations": false, "transparent": true,
      "alwaysOnTop": true, "shadow": false, "visible": true, "skipTaskbar": false
    }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'" }
  },
  "bundle": { "active": false, "icon": [] }
}
