# Local OmniRoute. Do not put credentials in the base URL.
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_API_KEY=
# Use an actual configured provider model or combo; no alias is assumed.
OMNIROUTE_MODEL=
# Optional existing Chrome/Edge executable; otherwise detect Windows installation.
DIGITALSOUL_BROWSER_EXECUTABLE=
ANONYMIZED_TELEMETRY=false

# Opt-in: send commands and routine names (not recorded values) to the configured model.
DIGITALSOUL_HERMES_CONSENT=0
# Optional overrides; Windows Hermes installation is discovered automatically.
DIGITALSOUL_HERMES_ROOT=
DIGITALSOUL_HERMES_PYTHON=
