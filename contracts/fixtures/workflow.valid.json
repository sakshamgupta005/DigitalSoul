{
  "workflow_id": "wf_at_risk_seg",
  "version": 4,
  "name": "Weekly at-risk customer segmentation",
  "description": "Reads overdue accounts, classifies each by plan and login age, saves tags, and posts a run-specific summary.",
  "trust": "validated",
  "provenance": {
    "evidence_episode_ids": [
      "ep_01",
      "ep_04",
      "ep_07",
      "ep_09"
    ],
    "support": 4,
    "alignment": 0.88
  },
  "parameters": [
    {
      "name": "account_ids",
      "type": "string[]",
      "source": "step:s2_copy_accounts.output",
      "origin": "inferred",
      "confirmed": true
    }
  ],
  "steps": [
    {
      "step_id": "s1_open_portal",
      "kind": "action",
      "verb": "navigate",
      "app": "acme-portal",
      "locators": [
        {
          "by": "text",
          "value": "Reports"
        }
      ],
      "input": "http://portal.acme.local/reports/overdue",
      "pre": [],
      "post": [
        {
          "type": "url_matches",
          "value": "/reports/overdue"
        }
      ],
      "risk": "R0",
      "required": true,
      "origin": "observed",
      "recovery": {
        "retries": 1,
        "on_fail": "pause"
      }
    },
    {
      "step_id": "s2_copy_accounts",
      "kind": "action",
      "verb": "read_field",
      "app": "acme-portal",
      "locators": [
        {
          "by": "testid",
          "value": "overdue-account-list"
        }
      ],
      "input": null,
      "pre": [
        {
          "type": "element_visible",
          "locator_ref": 0
        }
      ],
      "post": [],
      "risk": "R0",
      "required": true,
      "origin": "observed",
      "recovery": {
        "retries": 2,
        "on_fail": "pause"
      },
      "output_name": "account_ids",
      "output_type": "string[]"
    },
    {
      "step_id": "s3_loop_crm",
      "kind": "loop",
      "app": "acme-crm",
      "locators": [],
      "input": null,
      "loop_iterator": {
        "source_param": "account_ids",
        "item_name": "item",
        "max_iterations": 100
      },
      "pre": [],
      "post": [],
      "risk": "R0",
      "required": true,
      "origin": "inferred",
      "recovery": {
        "retries": 0,
        "on_fail": "abort"
      },
      "body": [
        {
          "step_id": "s3_open_record",
          "kind": "action",
          "verb": "navigate",
          "app": "acme-crm",
          "locators": [],
          "input": "http://crm.acme.local/customers/{{item}}",
          "pre": [],
          "post": [
            {
              "type": "record_id_matches",
              "value": "{{item}}"
            }
          ],
          "risk": "R0",
          "required": true,
          "origin": "observed",
          "recovery": {
            "retries": 0,
            "on_fail": "pause"
          }
        },
        {
          "step_id": "s3_read_plan",
          "kind": "action",
          "verb": "read_field",
          "app": "acme-crm",
          "locators": [
            {
              "by": "testid",
              "value": "customer-plan"
            }
          ],
          "input": null,
          "pre": [
            {
              "type": "record_id_matches",
              "value": "{{item}}"
            }
          ],
          "post": [],
          "risk": "R0",
          "required": true,
          "origin": "observed",
          "recovery": {
            "retries": 0,
            "on_fail": "pause"
          },
          "output_name": "plan",
          "output_type": "string"
        },
        {
          "step_id": "s3_read_days",
          "kind": "action",
          "verb": "read_field",
          "app": "acme-crm",
          "locators": [
            {
              "by": "testid",
              "value": "last-login-days"
            }
          ],
          "input": null,
          "pre": [
            {
              "type": "record_id_matches",
              "value": "{{item}}"
            }
          ],
          "post": [],
          "risk": "R0",
          "required": true,
          "origin": "observed",
          "recovery": {
            "retries": 0,
            "on_fail": "pause"
          },
          "output_name": "last_login_days",
          "output_type": "number"
        },
        {
          "step_id": "s3_decide",
          "kind": "decision",
          "app": "acme-crm",
          "locators": [],
          "pre": [],
          "post": [],
          "risk": "R0",
          "required": true,
          "origin": "inferred",
          "recovery": {
            "retries": 0,
            "on_fail": "abort"
          },
          "rule_id": "segment"
        },
        {
          "step_id": "s4_set_tag",
          "kind": "action",
          "verb": "select_option",
          "app": "acme-crm",
          "locators": [
            {
              "by": "testid",
              "value": "tag-select"
            },
            {
              "by": "role",
              "role": "combobox",
              "name": "Customer Tag"
            },
            {
              "by": "css",
              "value": "select#tag"
            }
          ],
          "input": "{{decision.segment}}",
          "pre": [
            {
              "type": "url_matches",
              "value": "/customers/{{item}}"
            },
            {
              "type": "record_id_matches",
              "value": "{{item}}"
            }
          ],
          "post": [
            {
              "type": "field_equals",
              "locator_ref": 0,
              "value": "{{decision.segment}}"
            }
          ],
          "risk": "R1",
          "required": true,
          "origin": "observed",
          "recovery": {
            "retries": 1,
            "on_fail": "pause"
          }
        },
        {
          "step_id": "s5_save_cust",
          "kind": "action",
          "verb": "click",
          "app": "acme-crm",
          "locators": [
            {
              "by": "testid",
              "value": "save-btn"
            },
            {
              "by": "role",
              "role": "button",
              "name": "Save"
            }
          ],
          "input": null,
          "pre": [
            {
              "type": "element_visible",
              "locator_ref": 0
            },
            {
              "type": "record_id_matches",
              "value": "{{item}}"
            }
          ],
          "post": [
            {
              "type": "network_2xx",
              "value": "/api/customers/{{item}}"
            }
          ],
          "risk": "R2",
          "required": true,
          "origin": "observed",
          "recovery": {
            "retries": 0,
            "on_fail": "pause"
          }
        }
      ]
    },
    {
      "step_id": "s6_open_notes",
      "kind": "action",
      "verb": "navigate",
      "app": "acme-portal",
      "locators": [],
      "input": "http://portal.acme.local/team/notes",
      "pre": [],
      "post": [
        {
          "type": "url_matches",
          "value": "/team/notes"
        }
      ],
      "risk": "R0",
      "required": true,
      "origin": "observed",
      "recovery": {
        "retries": 0,
        "on_fail": "pause"
      }
    },
    {
      "step_id": "s6_fill_summary",
      "kind": "action",
      "verb": "set_field",
      "app": "acme-portal",
      "locators": [
        {
          "by": "testid",
          "value": "team-note-body"
        }
      ],
      "input": "Weekly at-risk segmentation complete; run={{run_id}}; processed={{account_ids.length}}",
      "pre": [
        {
          "type": "url_matches",
          "value": "/team/notes"
        }
      ],
      "post": [
        {
          "type": "field_equals",
          "locator_ref": 0,
          "value": "Weekly at-risk segmentation complete; run={{run_id}}; processed={{account_ids.length}}"
        }
      ],
      "risk": "R1",
      "required": true,
      "origin": "observed",
      "recovery": {
        "retries": 0,
        "on_fail": "pause"
      }
    },
    {
      "step_id": "s6_post_summary",
      "kind": "action",
      "verb": "click",
      "app": "acme-portal",
      "locators": [
        {
          "by": "testid",
          "value": "post-team-note-btn"
        },
        {
          "by": "role",
          "role": "button",
          "name": "Post Weekly Summary"
        }
      ],
      "input": null,
      "pre": [
        {
          "type": "url_matches",
          "value": "/team/notes"
        }
      ],
      "post": [
        {
          "type": "network_2xx",
          "value": "/api/team/notes"
        }
      ],
      "risk": "R2",
      "required": true,
      "origin": "observed",
      "recovery": {
        "retries": 0,
        "on_fail": "pause"
      }
    }
  ],
  "decision_rules": [
    {
      "id": "segment",
      "expr": "plan == 'Pro' and last_login_days > 30",
      "then": "At-risk \u2013 High",
      "else": "At-risk \u2013 Watch",
      "origin": "inferred",
      "supported_runs": 4,
      "contradicting_runs": 0,
      "confirmed": true
    }
  ],
  "outcome_checks": [
    {
      "type": "app_api",
      "app": "acme-crm",
      "check": "tag_equals_for_all",
      "args": {
        "ids": "{{account_ids}}",
        "expected_by_id": "{{expected_tags}}"
      }
    },
    {
      "type": "app_api",
      "app": "acme-portal",
      "check": "team_note_exists",
      "args": {
        "containing": "Weekly at-risk segmentation complete; run={{run_id}}; processed={{account_ids.length}}",
        "run_id": "{{run_id}}",
        "expected_count": 1
      }
    }
  ],
  "remote_allowed": true
}
