{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digitalghost.local/schemas/omniroute_hypothesis.json",
  "title": "OmniRouteHypothesisResponse",
  "type": "object",
  "required": [
    "name",
    "description",
    "inferred_parameters",
    "inferred_decision_rules",
    "inferred_outcome_checks"
  ],
  "properties": {
    "name": {
      "type": "string",
      "description": "Human-readable label for the discovered workflow."
    },
    "description": {
      "type": "string",
      "description": "Summary of the business process and expected input/output."
    },
    "inferred_parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "type",
          "source",
          "description"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "string",
              "string[]",
              "number",
              "boolean"
            ]
          },
          "source": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "inferred_decision_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "expr",
          "then",
          "else",
          "explanation"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "expr": {
            "type": "string"
          },
          "then": {
            "type": "string"
          },
          "else": {
            "type": "string"
          },
          "explanation": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "inferred_outcome_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "app",
          "check",
          "args"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "app_api",
              "db_query",
              "page_assertion"
            ]
          },
          "app": {
            "type": "string"
          },
          "check": {
            "type": "string"
          },
          "args": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
